{
  "name": "Machine Learning Course",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "postCreateCommand": "pip install --no-cache-dir torch==2.10.0 --index-url https://download.pytorch.org/whl/cpu && pip install --no-cache-dir -r requirements.txt -c constraints.txt",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "jupyter.interactiveWindow.textEditor.executeSelection": true
      }
    },
    "codespaces": {
      "openFiles": ["README.md", "Module1_ML_Foundations/01_what_is_machine_learning.py"]
    }
  }
}
