    },
    {
      "name": "No over-valuation of top homes",
      "metric": "top-decile bias %",
      "threshold": 5.0,
      "higher_is_better": false,
      "hard": true,
      "weight": 0.0,
      "why": "Over-valuing the most expensive 10% creates the largest loan losses"
